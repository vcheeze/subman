{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "subman",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	"routes": [
		{
			"pattern": "subs.mammon-manager.com",
			"zone_name": "mammon-manager.com",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"preview_urls": true
}